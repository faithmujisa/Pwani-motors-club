      width:44px;
      height:44px;
      border-radius:50%;
      background:linear-gradient(135deg, var(--blue), var(--blue-dark));
      position:relative;
      box-shadow:var(--shadow);
      display:grid;
      place-items:center;
      overflow:hidden;
    }

    .logo-icon::before{
      content:"P";
      color:var(--white);
      font-size:1.6rem;
      font-weight:800;
      line-height:1;
    }

    .logo-text{
      font-size:1.05rem;
      color:var(--blue-dark);
    }

    .nav-links{
      display:flex;
      align-items:center;
      gap:24px;
      font-size:0.95rem;
      color:var(--text);
    }

    .nav-links a:hover{color:var(--blue)}

    .nav-btn{
      background:var(--blue);
      color:var(--white);
      padding:12px 20px;
      border-radius:999px;
      font-weight:700;
      box-shadow:var(--shadow);
    }

    .hero{
      background:
        linear-gradient(rgba(8, 24, 48, 0.72), rgba(8, 24, 48, 0.72)),
        url("pwani-motors-club-sticker.jpeg") center/contain no-repeat;
      min-height:620px;
      display:flex;
      align-items:center;
      color:var(--white);
    }

    .hero-inner{
      max-width:680px;
      padding:70px 0;
    }

    .tag{
      display:inline-block;
      padding:8px 14px;
      border:1px solid rgba(255,255,255,0.2);
      border-radius:999px;
      background:rgba(255,255,255,0.08);
      letter-spacing:0.12em;
      text-transform:uppercase;
      font-size:0.72rem;
      color:#edf4ff;
    }

    h1{
      font-size:clamp(2.7rem, 5vw, 5rem);
      margin:18px 0 16px;
      line-height:1.05;
    }

    .hero p{
      font-size:1.08rem;
      color:rgba(255,255,255,0.9);
      max-width:560px;
    }

    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:16px;
      margin-top:28px;
    }

    .primary-btn, .secondary-btn{
      display:inline-block;
      padding:15px 22px;
      border-radius:999px;
      font-weight:700;
      transition:0.25s ease;
    }

    .primary-btn{
      background:var(--blue);
      color:var(--white);
    }

    .secondary-btn{
      border:1px solid rgba(255,255,255,0.7);
      color:var(--white);
      background:transparent;
    }

    .primary-btn:hover, .secondary-btn:hover{
      transform:translateY(-2px);
    }

    .stats{
      display:grid;
      grid-template-columns:repeat(4, minmax(160px,1fr));
      gap:18px;
      margin-top:50px;
    }

    .stat{
      background:rgba(255,255,255,0.08);
      border:1px solid rgba(255,255,255,0.12);
      border-radius:18px;
      padding:18px 16px;
      backdrop-filter:blur(2px);
    }

    .stat strong{
      display:block;
      font-size:1.7rem;
      margin-bottom:4px;
    }

    .services{
      padding:90px 0;
      background:var(--light);
    }

    .section-head{
      text-align:center;
      margin-bottom:40px;
    }

    .section-head h2{
      font-size:clamp(2rem, 4vw, 3rem);
      margin:0 0 12px;
    }

    .section-head p{
      margin:0 auto;
      max-width:600px;
      color:var(--muted);
    }

    .card-grid{
      display:grid;
      grid-template-columns:repeat(3, minmax(220px,1fr));
      gap:24px;
    }

    .card{
      background:#fff;
      border-radius:22px;
      overflow:hidden;
      box-shadow:0 12px 28px rgba(17,24,39,0.06);
      border:1px solid rgba(17,24,39,0.05);
    }

    .card img{
      width:100%;
      height:220px;
      object-fit:cover;
    }

    .card-body{
      padding:22px 20px 24px;
    }

    .card-badge{
      display:inline-block;
      margin-bottom:12px;
      font-size:0.74rem;
      font-weight:700;
      color:var(--blue);
      background:rgba(11,61,145,0.08);
      padding:7px 12px;
      border-radius:999px;
    }

    .card h3{
      margin:0 0 8px;
      font-size:1.4rem;
    }

    .card p{
      margin:0;
      color:var(--muted);
    }

    .about{
      padding:90px 0;
    }

    .about-wrap{
      display:grid;
      grid-template-columns:1.1fr 0.9fr;
      gap:32px;
      align-items:center;
    }

    .about-text p{
      color:var(--muted);
      font-size:1.02rem;
    }

    .feature-box{
      display:grid;
      grid-template-columns:repeat(2, 1fr);
      gap:18px;
      margin-top:24px;
    }

    .feature{
      background:var(--light);
      border-radius:18px;
      padding:20px;
      box-shadow:0 10px 25px rgba(17,24,39,0.04);
    }

    .feature strong{
      display:block;
      color:var(--blue);
      margin-bottom:6px;
    }

    .about-image img{
      width:100%;
      height:470px;
      object-fit:cover;
      border-radius:24px;
      box-shadow:var(--shadow);
    }

    .cta{
      background:linear-gradient(120deg, var(--blue-dark), var(--blue));
      padding:26px 0;
      color:var(--white);
    }

    .cta-inner{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:20px;
    }

    .cta-inner h3{
      margin:0 0 8px;
      font-size:clamp(1.8rem, 3vw, 2.8rem);
    }

    .cta-inner p{
      margin:0;
      color:rgba(255,255,255,0.82);
    }

    footer{
      background:#08162d;
      color:rgba(255,255,255,0.8);
      padding:20px 0;
      font-size:0.95rem;
    }

    .footer-inner{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:16px;
      flex-wrap:wrap;
    }

    @media (max-width:900px){
      .nav-links{display:none}
      .card-grid, .feature-box, .about-wrap, .stats{
        grid-template-columns:1fr;
      }
      .cta-inner{
        flex-direction:column;
        align-items:flex-start;
      }
    }
  </style>
</head>
