<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PWANI MOTORSPORTS CLUB</title>
    <style>
      :root {
        --primary: #0b3d91;
        --primary-dark: #062a61;
        --accent: #ff8c1a;
        --dark: #111827;
        --muted: #6b7280;
        --light: #f3f6fb;
        --white: #ffffff;
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #fff;
        color: var(--dark);
        line-height: 1.6;
        position: relative;
      }
      img { max-width: 100%; display: block; }
      a { text-decoration: none; color: inherit; }

      .container {
        width: min(1100px, calc(100% - 30px));
        margin: 0 auto;
      }

      header {
        position: sticky;
        top: 0;
        background: rgba(255,255,255,0.96);
        border-bottom: 1px solid rgba(17,24,39,0.08);
        z-index: 10;
      }

      .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-height: 72px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 700;
        font-size: 1.2rem;
      }

      .brand-mark {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        color: white;
        display: grid;
        place-items: center;
        font-weight: 700;
      }

      .nav-links {
        display: flex;
        gap: 28px;
        font-size: 0.95rem;
      }

      .nav-links a:hover { color: var(--primary); }

      .btn {
        display: inline-block;
        padding: 14px 22px;
        border-radius: 999px;
        font-weight: 700;
        transition: 0.2s ease;
      }

      .btn-primary {
        background: var(--accent);
        color: white;
      }

      .btn-secondary {
        background: transparent;
        border: 1px solid rgba(255,255,255,0.7);
        color: white;
      }

      .hero {
        background: linear-gradient(rgba(7,20,46,0.72), rgba(7,20,46,0.72)),
                    url('pwani-motors-club-sticker.jpeg') center/contain no-repeat;
        min-height: 680px;
        display: flex;
        align-items: center;
        color: white;
      }

      .hero-content {
        max-width: 650px;
        padding: 70px 0;
      }

      .eyebrow {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.2);
        letter-spacing: 0.12em;
        font-size: 0.75rem;
        text-transform: uppercase;
      }

      h1 {
        font-size: clamp(2.6rem, 5vw, 5rem);
        line-height: 1.05;
        margin: 20px 0 18px;
      }

      .hero p {
        font-size: 1.08rem;
        color: rgba(255,255,255,0.9);
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 28px;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(150px, 1fr));
        gap: 18px;
        margin-top: 52px;
      }

      .stat {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 18px;
        padding: 18px;
      }

      .stat strong {
        display: block;
        font-size: 1.8rem;
      }

      section {
        padding: 90px 0;
      }

      .section-title {
        text-align: center;
        margin-bottom: 42px;
      }

      .section-title h2 {
        font-size: clamp(2rem, 4vw, 3rem);
        margin: 0 0 12px;
      }

      .section-title p {
        margin: 0 auto;
        max-width: 620px;
        color: var(--muted);
      }

      .about-wrap {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 34px;
        align-items: center;
      }

      .about-text {
        color: var(--muted);
        font-size: 1.03rem;
      }

      .about-points {
        display: grid;
        grid-template-columns: repeat(2, minmax(180px, 1fr));
        gap: 18px;
        margin-top: 28px;
      }

      .feature {
        background: var(--light);
        border-radius: 18px;
        padding: 20px;
        box-shadow: 0 10px 25px rgba(17,24,39,0.06);
      }

      .feature strong {
        display: block;
        color: var(--primary);
        margin-bottom: 6px;
      }

      .about-image {
        border-radius: 28px;
        overflow: hidden;
      }

      .services-grid, .cars-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(220px, 1fr));
        gap: 24px;
      }

      .card {
        background: #fff;
        border: 1px solid rgba(17,24,39,0.08);
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(17,24,39,0.04);
      }

      .card-image {
        height: 210px;
        object-fit: cover;
      }

      .card-body {
        padding: 22px 20px 24px;
      }

      .card h3 {
        margin: 0 0 8px;
        font-size: 1.4rem;
      }

      .card p {
        margin: 0;
        color: var(--muted);
      }

      .badge {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 999px;
        background: rgba(11,61,145,0.08);
        color: var(--primary);
        font-weight: 700;
        margin-bottom: 12px;
        font-size: 0.76rem;
      }

      .cta {
        background: linear-gradient(120deg, var(--primary-dark), var(--primary));
        color: #fff;
      }

      .merchandise {
        background: #101b35;
        color: var(--white);
      }

      .merchandise .section-title p { color: rgba(255,255,255,0.72); }

      .merch-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
      }

      .merch-card {
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 20px;
        background: rgba(255,255,255,0.07);
      }

      .merch-art {
        display: grid;
        place-items: center;
        height: 250px;
        padding: 18px;
        background-position: center;
        background-size: cover;
      }

      .merch-product-shirt { background-image: linear-gradient(rgba(255,140,26,0.15), rgba(255,140,26,0.15)), url('https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=800&q=85'); }
      .merch-product-cap { background-image: linear-gradient(rgba(24,197,207,0.18), rgba(24,197,207,0.18)), url('https://images.unsplash.com/photo-1588850561407-ed78c282e89b?auto=format&fit=crop&w=800&q=85'); }
      .merch-product-bottle { background-image: linear-gradient(rgba(242,211,155,0.18), rgba(242,211,155,0.18)), url('https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=800&q=85'); }
      .merch-product-notebook { background-image: linear-gradient(rgba(230,75,69,0.15), rgba(230,75,69,0.15)), url('https://images.unsplash.com/photo-1531346878377-a5be20888e57?auto=format&fit=crop&w=800&q=85'); }

      .merch-art img {
        width: 42%;
        height: 80%;
        object-fit: contain;
        filter: drop-shadow(0 8px 8px rgba(0,0,0,0.2));
      }

      .merch-product-shirt img { width: 48%; }
      .merch-product-cap img { width: 42%; }
      .merch-product-bottle img { width: 27%; }
      .merch-product-notebook img { width: 43%; }

      .merch-body { padding: 18px; }
      .merch-body h3 { margin: 0 0 6px; font-size: 1.25rem; }
      .merch-body p { margin: 0; color: rgba(255,255,255,0.7); font-size: 0.9rem; }
      .merch-link { display: inline-block; margin-top: 16px; color: var(--accent); font-weight: 700; }

      .cta-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
        min-height: 150px;
      }

      .cta-inner h3 {
        margin: 0 0 8px;
        font-size: clamp(1.8rem, 3vw, 2.7rem);
      }

      .cta-inner p {
        margin: 0;
        color: rgba(255,255,255,0.8);
      }

      .contact-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 30px;
      }

      .contact-box, .info-box {
        background: var(--light);
        border-radius: 22px;
        padding: 28px;
      }

      .info-box {
        background: linear-gradient(135deg, #edf4ff, #fdf5ee);
      }

      .info-list {
        list-style: none;
        padding: 0;
        margin: 22px 0 0;
      }

      .info-list li {
        margin-bottom: 18px;
      }

      .info-list strong { display: block; margin-bottom: 4px; }

      footer {
        background: #08162d;
        color: rgba(255,255,255,0.8);
        padding: 20px 0;
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
      }

      @media (max-width: 900px) {
        .nav-links { display: none; }
        .about-wrap, .contact-grid, .services-grid, .cars-grid, .stats {
          grid-template-columns: 1fr;
        }
        .cta-inner {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container nav">
        <div class="brand">
          <div class="brand-mark">P</div>
          <span>Pwani MotorsportsClub</span>
        </div>

        <nav class="nav-links" aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#services">Services</a>
          <a href="#fleet">Fleet</a>
          <a href="#merchandise">Merch</a>
          <a href="#contact">Contact</a>
        </nav>

        <a class="btn btn-primary" href="#contact">Book a Visit</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-content">
          <span class="eyebrow">Driving Excellence</span>
          <h1>Power, performance, and passion on every mile.</h1>
          <p>
            Pwani Motors Club brings together premium vehicles, trusted service, and a
            true automotive lifestyle for drivers across the coast and beyond.
          </p>

          <div class="hero-actions">
            <a class="btn btn-primary" href="#fleet">Explore Models</a>
            <a class="btn btn-secondary" href="#services">Our Services</a>
          </div>

          <div class="stats">
            <div class="stat">
              <strong>15+</strong>
              Years of Trust
            </div>
            <div class="stat">
              <strong>1200+</strong>
              Vehicles Sold
            </div>
            <div class="stat">
              <strong>4.9/5</strong>
              Customer Rating
            </div>
            <div class="stat">
              <strong>24/7</strong>
              Support
            </div>
          </div>
        </div>
      </section>

      <section id="about">
        <div class="container about-wrap">
          <div>
            <div class="section-title" style="text-align: left; margin-bottom: 20px;">
              <h2>Built for drivers who value quality.</h2>
            </div>
            <div class="about-text">
              <p>
                At Pwani Motors Club, we help customers find the right vehicle for their
                lifestyle, business, and adventure. From performance cars to family SUVs,
                we combine quality inventory with honest guidance and dependable after-sales
                service.
              </p>
              <p>
                Whether you are buying your first car or upgrading your fleet, our team is
                committed to delivering a smooth, confident, and rewarding experience.
              </p>
            </div>

            <div class="about-points">
              <div class="feature">
                <strong>Certified Vehicles</strong>
                Carefully selected and quality-checked rides.
              </div>
              <div class="feature">
                <strong>Flexible Financing</strong>
                Easy payment plans tailored to your needs.
              </div>
              <div class="feature">
                <strong>Expert Service</strong>
                Skilled technicians and trusted vehicle care.
              </div>
              <div class="feature">
                <strong>Club Perks</strong>
                Exclusive offers and premium member benefits.
              </div>
            </div>
          </div>

          <div class="about-image">
            <img
              src="pwani-motors-club-sticker.jpeg"
              alt="Luxury car showroom"
            />
          </div>
        </div>
      </section>

      <section id="services" style="background: var(--light);">
        <div class="container">
          <div class="section-title">
            <h2>What we offer</h2>
            <p>
              Comprehensive car solutions designed to keep your driving experience smooth,
              safe, and enjoyable.
            </p>
          </div>

          <div class="services-grid">
            <article class="card">
              <img
                class="card-image"
                src="pwani-motors-club-sticker.jpeg"
                alt="Car sales"
              />
              <div class="card-body">
                <span class="badge">Sales</span>
                <h3>New & Used Vehicles</h3>
                <p>Discover reliable, stylish, and performance-driven cars tailored to your budget.</p>
              </div>
            </article>

            <article class="card">
              <img
                class="card-image"
                src="pwani-motors-club-sticker.jpeg"
                alt="Vehicle service"
              />
              <div class="card-body">
                <span class="badge">Service</span>
                <h3>Maintenance & Repair</h3>
                <p>Keep your vehicle running at its best with scheduled servicing and diagnostics.</p>
              </div>
            </article>

            <article class="card">
              <img
                class="card-image"
                src="pwani-motors-club-sticker.jpeg"
                alt="Car financing"
              />
              <div class="card-body">
                <span class="badge">Finance</span>
                <h3>Flexible Financing</h3>
                <p>Benefit from practical payment options that make ownership easier and faster.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="fleet">
        <div class="container">
          <div class="section-title">
            <h2>Featured fleet</h2>
            <p>
              A selection of vehicles built for city commutes, family travel, and adventure-ready driving.
            </p>
          </div>

          <div class="cars-grid">
            <article class="card">
              <img
                class="card-image"
                src="pwani-motors-club-sticker.jpeg"
                alt="SUV vehicle"
              />
              <div class="card-body">
                <span class="badge">SUV</span>
                <h3>Ford Explorer</h3>
                <p>Spacious comfort, all-terrain capability, and premium control for modern families.</p>
              </div>
            </article>

            <article class="card">
              <img
                class="card-image"
                src="pwani-motors-club-sticker.jpeg"
                alt="Sedan vehicle"
              />
              <div class="card-body">
                <span class="badge">Sedan</span>
                <h3>Toyota Corolla</h3>
                <p>Dependable performance and elegant design for everyday driving and long trips.</p>
              </div>
            </article>

            <article class="card">
              <img
                class="card-image"
                src="pwani-motors-club-sticker.jpeg"
                alt="Luxury car"
              />
              <div class="card-body">
                <span class="badge">Luxury</span>
                <h3>BMW Series 3</h3>
                <p>Powerful engineering and refined style for drivers who appreciate performance.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="merchandise" class="merchandise">
        <div class="container">
          <div class="section-title">
            <h2>Wear the club</h2>
            <p>Carry the Pwani spirit from the paddock to the street with limited club essentials.</p>
          </div>

          <div class="merch-grid">
            <article class="merch-card">
              <div class="merch-art merch-product-shirt">
                <img src="pwani-motors-club-sticker-transparent.png" alt="Pwani Motors Club sticker printed on a T-shirt">
              </div>
              <div class="merch-body">
                <h3>Club T-shirt</h3>
                <p>Bold blue race-day cotton.</p>
                <a class="merch-link" href="#contact">Enquire &#8599;</a>
              </div>
            </article>

            <article class="merch-card">
              <div class="merch-art merch-product-cap">
                <img src="pwani-motors-club-sticker-transparent.png" alt="Pwani Motors Club sticker printed on a cap">
              </div>
              <div class="merch-body">
                <h3>Team Cap</h3>
                <p>Lightweight cyan paddock cap.</p>
                <a class="merch-link" href="#contact">Enquire &#8599;</a>
              </div>
            </article>

            <article class="merch-card">
              <div class="merch-art merch-product-bottle">
                <img src="pwani-motors-club-sticker-transparent.png" alt="Pwani Motors Club sticker printed on a water bottle">
              </div>
              <div class="merch-body">
                <h3>Water Bottle</h3>
                <p>Track-side hydration in sand.</p>
                <a class="merch-link" href="#contact">Enquire &#8599;</a>
              </div>
            </article>

            <article class="merch-card">
              <div class="merch-art merch-product-notebook">
                <img src="pwani-motors-club-sticker-transparent.png" alt="Pwani Motors Club sticker printed on a notebook">
              </div>
              <div class="merch-body">
                <h3>Race Notebook</h3>
                <p>Red cover for every fast idea.</p>
                <a class="merch-link" href="#contact">Enquire &#8599;</a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="container cta-inner">
          <div>
            <h3>Find the perfect ride for your next journey.</h3>
            <p>Get expert guidance from the Pwani Motors Club team today.</p>
          </div>
          <a class="btn btn-primary" href="#contact">Schedule a Consultation</a>
        </div>
      </section>

      <section id="contact">
        <div class="container contact-grid">
          <div class="contact-box">
            <div class="section-title" style="text-align: left; margin-bottom: 20px;">
              <h2>Visit us</h2>
            </div>
            <p style="color: var(--muted);">
              Experience our showroom, speak with our specialists, and discover a vehicle that fits your goals.
            </p>

            <div style="margin-top: 28px;">
              <iframe
                title="Pwani Motors Club location"
                src="https://www.google.com/maps?q=Mombasa%20Kenya&output=embed"
                width="100%"
                height="270"
                style="border:0; border-radius: 18px;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>

          <div class="info-box">
            <div class="section-title" style="text-align: left; margin-bottom: 0;">
              <h2>Contact info</h2>
            </div>

            <ul class="info-list">
              <li>
                <strong>Address</strong>
                Pwani Motors Club, Mombasa Road, Kenya
              </li>
              <li>
                <strong>Phone</strong>
                +254 700 000 000
              </li>
              <li>
                <strong>Email</strong>
                hello@pwanimotorsclub.co.ke
              </li>
              <li>
                <strong>Hours</strong>
                Mon - Sat: 8:00 AM - 7:00 PM
              </li>
            </ul>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <div>© <span id="year"></span> Pwani Motorsports Club</div>
        <div>Driven by passion United by Motorsport.</div>
      </div>
    </footer>

    <script>
      document.getElementById('year').textContent = new Date().getFullYear();
    </script>
  </body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pwani Motors Club</title>
  <style>
    :root{
      --blue:#0b3d91;
      --blue-dark:#071f4d;
      --orange:#ff8c1a;
      --white:#ffffff;
      --light:#f4f7fb;
      --text:#1a2433;
      --muted:#5d6774;
      --shadow:0 14px 35px rgba(11,61,145,0.15);
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: Arial, Helvetica, sans-serif;
      background:#fff;
      color:var(--text);
      line-height:1.6;
    }

    a{text-decoration:none;color:inherit}
    img{max-width:100%;display:block}

    .container{
      width:min(1120px, calc(100% - 30px));
